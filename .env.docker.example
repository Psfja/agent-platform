# 智构平台 Docker Compose 环境变量模板
# 用法：cp .env.docker.example .env  然后按需修改
# 生产环境务必修改 JWT_SECRET 与数据库密码

# ===== 安全（必改）=====
JWT_SECRET=please-change-this-to-a-random-string-of-at-least-32-characters

# ===== 对外端口 =====
API_PORT=8000
WEB_PORT=8080

# ===== PostgreSQL =====
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=agent_platform
POSTGRES_DB=agent_platform

# ===== 模型网关（真实 Agent 构建必需）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AGENT_ENGINE=deepagents

# ===== 沙箱与部署 =====
SANDBOX_BACKEND=docker
DEPLOYMENT_PUBLIC_HOST=localhost

# ===== 企业 SSO（可选）=====
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 前端经 Nginx 8080 端口访问时使用：
OIDC_REDIRECT_URI=http://localhost:8080/login/callback
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ===== 可选外部集成 =====
GIT_REMOTE_URL=
GIT_DEFAULT_BRANCH=main
# MinIO（启用 --profile storage 后填写）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-platform
# SMTP / Webhook
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_WEBHOOK_URL=

# ===== 演示数据 =====
SEED_DEMO_DATA=true
