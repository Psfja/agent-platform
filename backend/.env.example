APP_NAME=智构企业智能体平台 API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/agent_platform.db
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
SEED_DEMO_DATA=true
SQL_ECHO=false

# Skill registry (comma-separated directories)
SKILL_DIRECTORIES=./skills

# local = resource-limited subprocess (development)
# docker = Docker container with --network none (recommended)
SANDBOX_BACKEND=local
SANDBOX_DATA_DIR=./data/sandboxes
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_SECONDS=20
SANDBOX_OUTPUT_LIMIT=200000
SANDBOX_DOCKER_IMAGE=python:3.11-alpine

# OpenAI-compatible LLM gateway (DeepSeek, Qwen, One API, LiteLLM, etc.)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Autonomous full-stack build workspace
AGENT_BUILD_ROOT=data/generated
AGENT_MAX_FILES=80
AGENT_MAX_FILE_BYTES=300000
AGENT_BUILD_TIMEOUT_SECONDS=600
AGENT_BUILD_DOCKER_IMAGE=agent-build:py311-node20

# Generated application deployment
DEPLOYMENT_PUBLIC_HOST=localhost
DEPLOYMENT_SMOKE_TIMEOUT_SECONDS=45
DEPLOYMENT_BACKEND_MEMORY_MB=512
DEPLOYMENT_FRONTEND_MEMORY_MB=256

# Authentication and RBAC
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Durable task queue
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=agent-platform
QUEUE_FALLBACK_THREADS=true

# Platform schema migrations
RUN_DB_MIGRATIONS=true

# Enterprise SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4173/login/callback
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Git and object storage
GIT_REMOTE_URL=
GIT_DEFAULT_BRANCH=main
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=agent-platform
MINIO_SECURE=false

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_WEBHOOK_URL=

# Native DeepAgents orchestration
AGENT_ENGINE=deepagents
LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.sqlite

# Per-project generated application PostgreSQL schemas
GENERATED_DATABASE_URL=
GENERATED_DATABASE_BACKUP_DIR=data/generated-db-backups
